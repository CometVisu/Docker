#!/bin/sh
set -e

NO_ENTRYPOINT_APACHE=${NO_ENTRYPOINT_APACHE:-false}
NO_ENTRYPOINT_KNXD=${NO_ENTRYPOINT_KNXD:-false}
KNXD_SOCKET=${KNXD_SOCKET:-/run/knx}
APACHE_PORT=${APACHE_PORT:-80}

# Transport of the FastCGI backend to the KNX bus:
#   knxd        the backend talks to a knxd daemon over its Unix socket
#   ip-tunnel   the backend is a KNXnet/IP tunneling client (no knxd needed)
#   ip-routing  the backend joins the KNXnet/IP multicast group (no knxd needed)
# An empty value means knxd so that containers started before KNX_TRANSPORT
# existed keep working. An unknown value is a configuration error: silently
# falling back to knxd would hide it.
KNX_TRANSPORT=${KNX_TRANSPORT:-knxd}
case "${KNX_TRANSPORT}" in
    knxd|ip-tunnel|ip-routing)
        ;;
    *)
        echo "ERROR: invalid KNX_TRANSPORT '${KNX_TRANSPORT}' - allowed values are 'knxd', 'ip-tunnel' and 'ip-routing'"
        exit 1
        ;;
esac

CGI_URL_PATH=${CGI_URL_PATH:-/cgi-bin/}

if [ x"${BACKEND_NAME}" = x"default" ] || [ x"${BACKEND_NAME}" = x"" ]; then
    BACKEND_NAME="knxd"
fi

BACKEND_KNXD=${BACKEND_KNXD:-${CGI_URL_PATH}l}
BACKEND_OPENHAB=${BACKEND_OPENHAB:-$CGI_URL_PATH}
export BASE_URL=${BACKEND_KNXD%?}

echo "Server side configuration parameters:"
echo "BACKEND_NAME: '${BACKEND_NAME}'"
echo "BACKEND_KNXD: '${BACKEND_KNXD}'"
echo "BACKEND_MQTT: '${BACKEND_MQTT}'"
echo "BACKEND_OPENHAB: '${BACKEND_OPENHAB}'"
echo "CGI_URL_PATH: '${CGI_URL_PATH}' (deprecated)"
echo "knxd baseURL: '${BASE_URL}'"

echo "#!/bin/sh" >  /usr/local/bin/healthcheck
chmod a+x /usr/local/bin/healthcheck

if [ x"${STOP_ON_BAD_HEALTH}" = x"true" ]
    then echo "badhealth='apachectl stop'" >> /usr/local/bin/healthcheck
    else echo "badhealth='true'" >> /usr/local/bin/healthcheck
fi

# Helper function for healthcheck failures - logs error to container stdout (docker logs)
echo 'healthcheck_fail() {' >> /usr/local/bin/healthcheck
echo '    echo "$1" | tee /proc/1/fd/1' >> /usr/local/bin/healthcheck
echo '    $badhealth > /dev/null 2>&1' >> /usr/local/bin/healthcheck
echo '    exit 1' >> /usr/local/bin/healthcheck
echo '}' >> /usr/local/bin/healthcheck

if [ x"${ADDITIONAL_HEALTHCHECK}" != x"" ]; then
    echo "${ADDITIONAL_HEALTHCHECK}" >> /usr/local/bin/healthcheck
fi

# How knxd is handled:
#   NO_ENTRYPOINT_KNXD=false   knxd is started inside this container (default)
#   NO_ENTRYPOINT_KNXD=extern  knxd is not started, the socket of an external
#                              knxd is used instead (path given by KNXD_SOCKET)
#   NO_ENTRYPOINT_KNXD=true    neither knxd nor the FastCGI backend is started
# All of this only applies to the knxd transport: the KNXnet/IP transports talk
# to the bus themselves and never need a knxd - neither bundled nor external.
START_KNXD="true"
USE_EXTERNAL_KNXD="false"
if [ x"${KNX_TRANSPORT}" = x"knxd" ]; then
    if [ x"${NO_ENTRYPOINT_KNXD}" = x"extern" ]; then
        START_KNXD="false"
        USE_EXTERNAL_KNXD="true"
    elif [ x"${NO_ENTRYPOINT_KNXD}" != x"false" ]; then
        START_KNXD="false"
    fi
else
    START_KNXD="false"
fi

# Export the value of the environment variable named by $1 only when it is set
# and not empty. The FastCGI backend applies its own defaults to everything it
# does not find in the environment, an empty value would override them.
export_if_set() {
    _eis_name="$1"
    _eis_value=""
    eval "_eis_value=\${${_eis_name}:-}"
    if [ x"${_eis_value}" != x"" ]; then
        export "${_eis_name}=${_eis_value}"
    else
        unset "${_eis_name}"
    fi
}

# Log a setting for the startup output. Unset values are marked as such - the
# backend then falls back to its own default.
show_setting() {
    _ss_value=""
    eval "_ss_value=\${$1:-}"
    if [ x"${_ss_value}" = x"" ]; then
        echo "$1: (not set, backend default)"
    else
        echo "$1: '${_ss_value}'"
    fi
}

# Validate a KNX individual address 'A.B.C' - A is the area and B the line
# (both 0..15), C the device (0..255). The router rejects 0.0.0 as the source
# of a routing telegram.
validate_individual_addr() {
    _via_value="$1"
    _via_ok="true"
    case "${_via_value}" in
        *.*.*)
            # Reject a fourth component ("a.b.c.d" would otherwise be parsed
            # as a= a, b= b, c= c.d).
            _via_rest="${_via_value#*.}"
            case "${_via_rest}" in
                *.*.*) _via_ok="false" ;;
                *.*) ;;
                *) _via_ok="false" ;;
            esac
            ;;
        *)
            _via_ok="false"
            ;;
    esac
    if [ x"${_via_ok}" = x"true" ]; then
        _via_a="${_via_value%%.*}"
        _via_rest="${_via_value#*.}"
        _via_b="${_via_rest%%.*}"
        _via_c="${_via_rest#*.}"
        for _via_part in "${_via_a}" "${_via_b}" "${_via_c}"; do
            case "${_via_part}" in
                ''|*[!0-9]*) _via_ok="false" ;;
            esac
        done
    fi
    if [ x"${_via_ok}" = x"true" ]; then
        if [ "${_via_a}" -gt 15 ] || [ "${_via_b}" -gt 15 ] || [ "${_via_c}" -gt 255 ]; then
            _via_ok="false"
        fi
    fi
    if [ x"${_via_ok}" = x"true" ]; then
        if [ "${_via_a}" -eq 0 ] && [ "${_via_b}" -eq 0 ] && [ "${_via_c}" -eq 0 ]; then
            _via_ok="false"
        fi
    fi
    if [ x"${_via_ok}" != x"true" ]; then
        echo "ERROR: KNX_IP_INDIVIDUAL_ADDR '${_via_value}' is not a valid KNX individual address - expected A.B.C with A and B in 0..15, C in 0..255 and not 0.0.0"
        exit 1
    fi
}

# Sanity checks that only apply to the KNXnet/IP transports: they need no knxd
# address and no client connections, but the tunnel needs a target and the
# routing needs a usable individual address.
validate_ip_transport() {
    case "${KNX_TRANSPORT}" in
        ip-tunnel)
            if [ x"${KNX_IP_HOST}" = x"" ]; then
                echo "ERROR: KNX_TRANSPORT=ip-tunnel requires KNX_IP_HOST (the address of the KNX IP interface or KNX IP router)"
                exit 1
            fi
            ;;
        ip-routing)
            # Unset means "use the backend default" (15.15.250), which is valid.
            if [ x"${KNX_IP_INDIVIDUAL_ADDR}" != x"" ]; then
                validate_individual_addr "${KNX_IP_INDIVIDUAL_ADDR}"
            fi
            echo "NOTE: KNXnet/IP routing uses the multicast group ${KNX_IP_MULTICAST:-224.0.23.12}, which does not cross the Docker bridge network - run the container with '--network host'"
            ;;
    esac
}

start_fcgi_backend() {
    # Start cometvisu-knx-fcgi (2.x) in socket mode: the binary opens FCGI_SOCKET
    # itself and reaches the KNX bus using the transport given by KNX_TRANSPORT.
    export FCGI_SOCKET=${FCGI_SOCKET:-/run/cometvisu-fcgi.sock}
    # Pass the transport through unchanged - an invalid value has already been
    # rejected at the top of this script.
    export KNX_TRANSPORT
    export LONGPOLL_TIMEOUT_SEC=${LONGPOLL_TIMEOUT_SEC:-300}
    export KNX_TX_MAX_PER_SEC=${KNX_TX_MAX_PER_SEC:-10}
    export DEBUG_BACKEND=${DEBUG_BACKEND:-}
    export FCGI_WORKERS=${FCGI_WORKERS:-9}
    # Empty KNX_IP_* variables are not passed on, so that the defaults of the
    # backend stay in effect. The image ships them empty and they are only used
    # by the KNXnet/IP transports, so this keeps the environment of the backend
    # unchanged for the knxd transport.
    export_if_set KNX_IP_HOST
    export_if_set KNX_IP_PORT
    export_if_set KNX_IP_LOCAL_ADDR
    export_if_set KNX_IP_NAT
    export_if_set KNX_IP_HEARTBEAT_SEC
    export_if_set KNX_IP_ACK_TIMEOUT_MS
    export_if_set KNX_IP_RETRIES
    export_if_set KNX_IP_MULTICAST
    export_if_set KNX_IP_IFACE
    export_if_set KNX_IP_INDIVIDUAL_ADDR
    if [ x"${KNX_TRANSPORT}" = x"knxd" ]; then
        if [ x"${USE_EXTERNAL_KNXD}" = x"true" ]; then
            # Talk to the socket provided by the external knxd.
            export KNXD_SOCKET
            echo "KNXD_SOCKET: '${KNXD_SOCKET}'"
        else
            # The knxd started by this container uses its default socket path.
            unset KNXD_SOCKET
            echo "KNXD_SOCKET: '/run/knx' (default, knxd is started by this container)"
        fi
        # Extract knxd client count from KNX_CLIENT_PAS (format: <addr>:<count>).
        # Since 2.x the backend uses exactly ONE knxd client connection (the cache
        # reader); the workers only enqueue telegrams into shared memory.  The
        # client count is therefore independent of FCGI_WORKERS - it only has to
        # leave room for the cache reader (and a spare for knxtool).
        if [ x"${START_KNXD}" = x"true" ]; then
            KNXD_CLIENT_COUNT="${KNX_CLIENT_PAS##*:}"
            case "${KNXD_CLIENT_COUNT}" in
                ''|*[!0-9]*)
                    echo "ERROR: cannot determine knxd client count from KNX_CLIENT_PAS ('${KNX_CLIENT_PAS}') - expected the format <address>:<count>"
                    exit 1
                    ;;
            esac
            if [ "${KNXD_CLIENT_COUNT}" -lt 2 ]; then
                echo "ERROR: KNX_CLIENT_PAS client count (${KNXD_CLIENT_COUNT}) is too low - at least 2 client connections are required (one for the backend's cache reader, one for tools like knxtool)"
                exit 1
            fi
        fi
    else
        # KNXnet/IP: neither a bundled nor an external knxd is involved, so no
        # knxd settings are needed or evaluated.
        unset KNXD_SOCKET
        echo "KNXnet/IP settings ('not set' means the default of the backend is used):"
        show_setting KNX_IP_HOST
        show_setting KNX_IP_PORT
        show_setting KNX_IP_IFACE
        show_setting KNX_IP_MULTICAST
        show_setting KNX_IP_INDIVIDUAL_ADDR
        show_setting KNX_IP_NAT
    fi
    # The backend reserves two workers for /w and /l so that a long-poll can
    # never delay a switch operation; below 2 workers that reservation is not
    # possible.  256 is the backend's hard limit.
    if [ "${FCGI_WORKERS}" -lt 2 ]; then
        echo "WARNING: FCGI_WORKERS (${FCGI_WORKERS}) must be larger than 1, increasing to 2"
        export FCGI_WORKERS=2
    fi
    if [ "${FCGI_WORKERS}" -gt 256 ]; then
        echo "WARNING: FCGI_WORKERS (${FCGI_WORKERS}) exceeds the backend limit of 256, reducing to 256"
        export FCGI_WORKERS=256
    fi
    echo "KNX_TRANSPORT: '${KNX_TRANSPORT}'"
    echo "LONGPOLL_TIMEOUT_SEC: '${LONGPOLL_TIMEOUT_SEC}'"
    echo "KNX_TX_MAX_PER_SEC: '${KNX_TX_MAX_PER_SEC}'"
    echo "FCGI_WORKERS: '${FCGI_WORKERS}'"
    if [ x"${DEBUG_BACKEND}" = x"1" ]; then
        echo "DEBUG_BACKEND: enabled"
    fi
    echo -n "starting cometvisu-knx-fcgi - version: " && cometvisu-knx-fcgi --version
    cometvisu-knx-fcgi &
    sleep 2
    if [ ! -S "${FCGI_SOCKET}" ]; then
        echo "Error: cometvisu-knx-fcgi socket does not exist at ${FCGI_SOCKET}";
        exit 1;
    fi
    # The backend creates the Unix socket as 0660 root:root; Apache runs as
    # www-data, so hand the socket group over instead of making it world
    # writable.
    chown root:www-data "${FCGI_SOCKET}"
    chmod 0660 "${FCGI_SOCKET}"
    echo "if ! pgrep -f cometvisu-knx-fcgi >/dev/null; then healthcheck_fail 'Error: cometvisu-knx-fcgi not running'; fi" >> /usr/local/bin/healthcheck
    echo "if [ ! -S \"\${FCGI_SOCKET}\" ]; then healthcheck_fail 'Error: cometvisu-knx-fcgi socket does not exist'; fi" >> /usr/local/bin/healthcheck
}

if [ x"${KNX_TRANSPORT}" != x"knxd" ]; then
    # Direct KNXnet/IP connection: the bundled knxd is never started (whatever
    # NO_ENTRYPOINT_KNXD says) and no knxd health check is generated, but the
    # FastCGI backend always is.
    validate_ip_transport
    start_fcgi_backend
elif [ x"${USE_EXTERNAL_KNXD}" = x"true" ]; then
    echo "using external knxd socket '${KNXD_SOCKET}' (knxd is not started by this container)"
    if [ "${KNXD_PARAMETERS}" != "" ] || [ "${KNX_INTERFACE}" != "" ]; then
        echo "NOTE: KNXD_PARAMETERS, KNX_INTERFACE, KNX_INTERFACE_OPTIONS, KNX_PA and KNX_CLIENT_PAS are ignored when an external knxd is used"
    fi
    if [ ! -S "${KNXD_SOCKET}" ]; then
        echo "WARNING: no knxd socket found at '${KNXD_SOCKET}'"
        echo "WARNING: mount the socket of the external knxd into this container - the FastCGI backend will keep retrying until it is reachable"
    fi
    # No knxd health check is generated: knxd is not controlled by this container
    start_fcgi_backend
elif [ "${KNXD_PARAMETERS}" != "" ] || [ "${KNX_INTERFACE}" != "" ]; then
    if [ "${KNXD_PARAMETERS}" != "" ]; then
        echo "creating knxd config file completely based on values from KNXD_PARAMETERS (${KNXD_PARAMETERS})"
        echo ""
        echo "NOTE: we can't check whether your KNXD_PARAMETERS is valid. When the" 
        echo "knxd doesn't start up a bad KNXD_PARAMETERS is most likely the case."
        echo "Consider to remove it and use the individual options instead!"
    else
        BAD_KNXD_CONFIG="false"
        if [ x"${KNX_PA}" = x"" ]; then
            echo 'ERROR: you MUST specify "KNX_PA" when using the knxd backend!'
            BAD_KNXD_CONFIG="true"
        fi
        if [ x"${KNX_CLIENT_PAS}" = x"" ]; then
            echo 'ERROR: you MUST specify "KNX_CLIENT_PAS" when using the knxd backend!'
            BAD_KNXD_CONFIG="true"
        fi
        if [ x"${KNX_INTERFACE}" = x"" ]; then
            echo 'ERROR: you MUST specify "KNX_INTERFACE" when using the knxd backend!'
            BAD_KNXD_CONFIG="true"
        fi
        if [ x"${BAD_KNXD_CONFIG}" = x"true" ]; then
            echo 'FATAL ERROR: stopping, as no valid knxd config given.'
            exit 1
        fi

        KNX_DAEMON_OPTIONS=""
        if [ x"${NO_ENTRYPOINT_KNXD}" = x"false" ]; then
            KNX_DAEMON_OPTIONS=" -d/var/log/knxd.log"
        fi
        KNXD_PARAMETERS="-e ${KNX_PA} -E ${KNX_CLIENT_PAS} -u${KNX_DAEMON_OPTIONS} -c ${KNX_INTERFACE_OPTIONS} -b ${KNX_INTERFACE}"
        echo "creating knxd config file from single parameters (${KNXD_PARAMETERS})"
    fi
    /usr/lib/knxd_args ${KNXD_PARAMETERS} > /etc/knxd.ini
    # modify knxd.conf to use knxd.ini
    sed -i 's/^KNXD_OPTS=.*/KNXD_OPTS=\/etc\/knxd.ini/' /etc/knxd.conf

    if [ x"${NO_ENTRYPOINT_KNXD}" = x"false" ]; then
        KNXD_BINARY=/usr/bin/knxd
        KNXD_VERSION=$(${KNXD_BINARY} --version 2>&1 | sed 's/^[^ ]* //')
        echo -n "starting knxd - version: " && echo "${KNXD_VERSION}"

        export LOGIN_EXTRA_CONFIG='"knxdRuntimeVersion":"'${KNXD_VERSION}'"'
        echo "LOGIN_EXTRA_CONFIG: '${LOGIN_EXTRA_CONFIG}'"

        ${KNXD_BINARY} /etc/knxd.ini
        sleep 5
        if [ ! -S "/run/knx" ]; then 
            echo 'Error: knxd socket does not exist'
            echo 'Running processes:'
            ps aux | grep knxd
            echo 'Directory listing of /run:'
            ls -la /run;
            echo '/var/log/knxd.log:'
            cat /var/log/knxd.log || true
            exit 1; 
        fi
        chmod a+rwx /run/knx || true

        echo "if ! pgrep -f knxd >/dev/null; then healthcheck_fail 'Error: knxd not running'; fi" >> /usr/local/bin/healthcheck
        echo "if [ ! -S /run/knx ]; then healthcheck_fail 'Error: knxd socket does not exist'; fi" >> /usr/local/bin/healthcheck

        start_fcgi_backend
    fi
fi

# Tell the CometVisu the paths to the backends using HTTP response headers.
# This configuration is written to its own file which is completely rewritten on
# every start. Appending to cv-docker-php.conf would grow that file by another
# "FilesMatch" section on each start of the container (see issue #1355).
{
    echo '# This file is generated by the cometvisu-entrypoint script.'
    echo '# It is rewritten completely on every container start - do NOT edit it manually!'
    echo '<FilesMatch "visu_config.*xml$">'
    if [ x"${BACKEND_NAME}" != x"" ]; then
        echo "    Header set X-CometVisu-Backend-Name ${BACKEND_NAME}"
    fi
    if [ x"${BACKEND_KNXD}" != x"" ]; then
        echo "    Header set X-CometVisu-Backend-KNXD-Url ${BACKEND_KNXD}"
    fi
    if [ x"${BACKEND_MQTT}" != x"" ]; then
        echo "    Header set X-CometVisu-Backend-MQTT-Url ${BACKEND_MQTT}"
    fi
    if [ x"${BACKEND_OPENHAB}" != x"" ]; then
        echo "    Header set X-CometVisu-Backend-OpenHAB-Url ${BACKEND_OPENHAB}"
    fi
    echo '</FilesMatch>'
} > "$APACHE_CONFDIR/conf-available/cv-docker-headers.conf"

if [ ! -e "$APACHE_CONFDIR/conf-enabled/cv-docker-headers.conf" ]; then
    a2enconf cv-docker-headers > /dev/null
fi

if [ x"${BACKEND_PROXY_SOURCE}" != x"" ] && [ x"${BACKEND_PROXY_TARGET}" != x"" ]; then
    echo "proxying ${BACKEND_PROXY_SOURCE} -> ${BACKEND_PROXY_TARGET}"
    # exclude manager backend from proxying
    echo "ProxyPass" /rest/manager !                                        >  $APACHE_CONFDIR/conf-available/cv-proxy.conf
    echo "ProxyPass ${BACKEND_PROXY_SOURCE} ${BACKEND_PROXY_TARGET}"        >> $APACHE_CONFDIR/conf-available/cv-proxy.conf
    echo "ProxyPassReverse ${BACKEND_PROXY_TARGET} ${BACKEND_PROXY_SOURCE}" >> $APACHE_CONFDIR/conf-available/cv-proxy.conf

    a2enmod proxy_http > /dev/null
    a2enconf cv-proxy.conf > /dev/null
fi

if [ x"${NO_ENTRYPOINT_APACHE}" = x"false" ]; then

    if [ -e "/var/log/apache2/access.log" ]; then
        rm -f /var/log/apache2/access.log
    fi

    if [ x"${ACCESS_LOG}" = x"true" ]
        then ln -f -s /dev/stdout /var/log/apache2/access.log
        else ln -f -s /dev/null /var/log/apache2/access.log
    fi

    # Expert option: let Apache listen on a different port than 80.
    # Both files need to be adapted, otherwise the requests end up in the
    # default server which has no DocumentRoot.
    if [ x"${APACHE_PORT}" != x"80" ]; then
        echo "configuring Apache to listen on port ${APACHE_PORT}"
        sed -i "s/^Listen 80$/Listen ${APACHE_PORT}/" "${APACHE_CONFDIR}/ports.conf"
        sed -i "s/^<VirtualHost \*:80>$/<VirtualHost *:${APACHE_PORT}>/" "${APACHE_CONFDIR}/sites-available/000-default.conf"
    fi

    echo "if ! curl -f -s http://localhost:${APACHE_PORT}/ >/dev/null; then healthcheck_fail 'Error: apache not responding'; fi" >> /usr/local/bin/healthcheck

    # first arg is `-f` or `--some-option`
    if [ x"${1#-}" != x"$1" ]; then
        set -- apache2-foreground "$@"
    fi
fi
  
echo "running '$@'..."
exec "$@"
